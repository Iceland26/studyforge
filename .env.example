# StudyForge — Firebase web config (copy to ".env" and fill in real values)
#
# Create a Firebase project (console.firebase.google.com), stay on the
# no-cost Spark plan, open "AI Logic" and choose the **Gemini Developer API**
# provider, register a Web app, then paste its config values below.
# These values are NOT secret keys, but keep real project values out of git
# anyway if you prefer — .env is gitignored.
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# App Check: for the contest build the Debug provider is used in dev.
# Set this to "true" while developing locally, then register the debug token
# printed in the browser console under Firebase Console -> App Check ->
# Apps -> Manage debug tokens. Debug tokens are accepted in submissions.
VITE_APPCHECK_DEBUG=true

# Optional: override the cloud fallback / escalation model.
# Defaults to gemini-3.5-flash-lite (the SDK v13 default cloud leg).
# VITE_CLOUD_MODEL=gemini-3.5-flash-lite
